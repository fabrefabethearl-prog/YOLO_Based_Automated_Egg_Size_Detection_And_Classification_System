{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run EggScan (FastAPI)",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\uvicorn.exe",
			"args": [
				"backend.main:app",
				"--reload",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": [
				"$python"
			],
			"group": "build"
		}
	]
}