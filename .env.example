# Copy to .env, set every required value, and keep .env private.

# Generate a fresh value with Python before running the app.
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:///./data/eggscan.db
# Existing administrator login identity; keep it matched to the existing users table.
ADMIN_EMAIL=admin@example.com
ADMIN_SESSION_TTL_MINUTES=720
# Optional password-only mode for local demos. It is rejected for non-loopback clients.
EGGSCAN_LOCAL_DEMO_LOGIN=false
# Gmail SMTP sender. Use a Google App Password (with 2-Step Verification enabled),
# not your normal Gmail password. Port 587 uses STARTTLS; port 465 uses SSL.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=admin@example.com
SMTP_APP_PASSWORD=replace-with-a-google-app-password
# auto follows the request scheme; set true behind a trusted HTTPS reverse proxy.
EGGSCAN_COOKIE_SECURE=auto
# HTTPS origin used in phone pairing QR links. Use an HTTPS public hostname for
# cross-network access, or a trusted private LAN URL for local-only pairing.
# EGGSCAN_PHONE_BASE_URL=https://eggscan.example.net
# STUN helps peers discover direct network paths. Replace with a service you are
# authorized to use for production.
EGGSCAN_STUN_URLS=stun:stun.l.google.com:19302
# Optional coturn REST-compatible TURN relay. Keep the shared secret server-side.
# EGGSCAN_TURN_URLS=turn:turn.example.net:3478?transport=udp,turns:turn.example.net:5349?transport=tcp
# EGGSCAN_TURN_SHARED_SECRET=generate-a-random-secret-of-at-least-32-characters
EGGSCAN_TURN_CREDENTIAL_TTL_SECONDS=3600
